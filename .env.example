HOST=0.0.0.0
PORT=3187
GLASS_LEDGER_DATA_DIR=./data
# Railway volume mount can use /data. If GLASS_LEDGER_DATA_DIR is omitted there,
# the app will also auto-detect RAILWAY_VOLUME_MOUNT_PATH.
GLASS_LEDGER_ADMIN_CODE=CHANGE_THIS_TO_A_STRONG_ADMIN_CODE
# Optional: create one initial manager account on first boot.
GLASS_LEDGER_MANAGER_CODE=CHANGE_THIS_TO_A_STRONG_MANAGER_CODE
GLASS_LEDGER_MANAGER_NAME=Анхны худалдааны менежер
# Optional: keep this at 0 on Railway/public hosting.
GLASS_LEDGER_ALLOW_INSECURE_DEFAULTS=0
GLASS_LEDGER_LOGIN_MAX_ATTEMPTS=8
GLASS_LEDGER_LOGIN_WINDOW_MINUTES=15
GLASS_LEDGER_LOGIN_BLOCK_MINUTES=15
